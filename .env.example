# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Docker:  mongodb://localhost:27017/doctor-tracker
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/doctor-tracker

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_HOURS=24
COOKIE_NAME=dt_session

# Comma-separated browser origins allowed to call the API directly (CORS).
# In production the frontend proxies /api through its own origin, so this mainly matters locally.
CLIENT_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Demo accounts created by `npm run seed` (these defaults are used if unset).
SEED_ADMIN_EMAIL=admin@doctortracker.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_VIEWER_EMAIL=viewer@doctortracker.test
SEED_VIEWER_PASSWORD=Viewer@12345
